{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(gtm-write|hubspot-write|meta-ads-official|ads-write|ga4-write)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/lote_guard.py\"",
            "timeout": 15,
            "statusMessage": "Conferindo lote aprovado e documenta\u00e7\u00e3o"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/lote_status_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(gtm-write|hubspot-write|meta-ads-official|ads-write|ga4-write)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/lote_log.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/lote_approve.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
